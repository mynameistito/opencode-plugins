{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-plugins",
  "private": true,
  "description": "OpenCode plugins maintained in a Bun workspace.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run scripts/run-workspaces.ts build",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "knip": "knip",
    "release:tag": "bun scripts/git-tag.ts",
    "release:stage": "bun scripts/stage-packages.ts",
    "version-pr-title": "bun scripts/version-pr-title.ts",
    "test": "bun run scripts/run-workspaces.ts test",
    "test:package": "bun run scripts/run-workspaces.ts test:package",
    "typecheck": "tsc --noEmit && bun run --filter '*' typecheck",
    "changeset": "changeset",
    "changeset-add": "bun run scripts/changeset-add.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@opentui/core": "catalog:",
    "@opentui/solid": "catalog:",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "5.0.1",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-sonarjs": "^4.2.1",
    "knip": "6.37.0",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "tsdown": "^0.23.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "ultracite": "7.12.0",
    "vite-plugin-solid": "2.11.14",
    "vitest": "5.0.1"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-rc.112"
  },
  "packageManager": "bun@1.4.2",
  "catalog": {
    "@opencode/plugin": "2.0.11",
    "@opentui/core": "0.5.11",
    "@opentui/solid": "0.5.11",
    "effect": "4.0.0-rc.112",
    "solid-js": "1.9.15"
  }
}
