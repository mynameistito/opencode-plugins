{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-plugins",
  "private": true,
  "description": "OpenCode plugins maintained in a Bun workspace.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run scripts/run-workspaces.ts build",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "knip": "knip",
    "release:tag": "bun scripts/git-tag.ts",
    "release:stage": "bun scripts/stage-packages.ts",
    "version-pr-title": "bun scripts/version-pr-title.ts",
    "test": "bun run scripts/run-workspaces.ts test",
    "test:package": "bun run scripts/run-workspaces.ts test:package",
    "typecheck": "tsc --noEmit && bun run --filter '*' typecheck",
    "changeset": "changeset",
    "changeset-add": "bun run scripts/changeset-add.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@opentui/core": "catalog:",
    "@opentui/solid": "catalog:",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.2",
    "@typescript/native": "catalog:",
    "@vitest/coverage-v8": "5.0.1",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-sonarjs": "^4.2.1",
    "knip": "6.37.0",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "tsdown": "^0.23.0",
    "typescript": "catalog:",
    "ultracite": "7.12.0",
    "vite-plugin-solid": "2.11.14",
    "vitest": "5.0.1"
  },
  "overrides": {
    "@chevrotain/cst-dts-gen>lodash": "4.18.1",
    "@chevrotain/cst-dts-gen>lodash-es": "4.18.1",
    "@chevrotain/gast>lodash": "4.18.1",
    "@chevrotain/gast>lodash-es": "4.18.1",
    "@effect/platform-node-shared": "4.0.0-rc.115",
    "@opentelemetry/exporter-trace-otlp-http>@opentelemetry/core": "2.8.0",
    "@opentelemetry/otlp-exporter-base>@opentelemetry/core": "2.8.0",
    "@opentelemetry/otlp-transformer>@opentelemetry/core": "2.8.0",
    "@opentelemetry/resources>@opentelemetry/core": "2.8.0",
    "@opentelemetry/sdk-logs>@opentelemetry/core": "2.8.0",
    "@opentelemetry/sdk-metrics>@opentelemetry/core": "2.8.0",
    "@opentelemetry/sdk-trace-base>@opentelemetry/core": "2.8.0",
    "@opentelemetry/sdk-trace-node>@opentelemetry/core": "2.8.0",
    "@opentui/solid>@babel/core": "7.29.7",
    "@prisma/dev>@hono/node-server": "1.19.15",
    "@prisma/dev>hono": "4.13.8",
    "@prisma/dev>valibot": "1.4.2",
    "@scalar/json-magic>undici": "7.29.1",
    "@vercel/routing-utils>path-to-regexp": "6.3.0",
    "chevrotain>lodash": "4.18.1",
    "chevrotain>lodash-es": "4.18.1"
  },
  "packageManager": "bun@1.4.2",
  "catalog": {
    "@effect/platform-bun": "4.0.0-rc.115",
    "@effect/platform-node": "4.0.0-rc.115",
    "@opencode/plugin": "2.0.16",
    "@opentui/core": "0.5.12",
    "@opentui/solid": "0.5.12",
    "@typescript/native": "npm:typescript@^7.0.2",
    "effect": "4.0.0-rc.115",
    "solid-js": "1.9.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
