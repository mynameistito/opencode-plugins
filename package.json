{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-plugins",
  "private": true,
  "description": "OpenCode plugins maintained in a Bun workspace.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --filter './packages/*' --filter './apps/*' --if-present build",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "knip": "knip",
    "test": "bun run --sequential --filter './packages/*' --filter './apps/*' --if-present test && bun run --bun vitest run .github/scripts/__tests__ scripts/package-tarball/__tests__",
    "test:package": "bun run --filter './packages/*' --filter './apps/*' --if-present test:package",
    "typecheck": "tsc --noEmit && bun run --filter './packages/*' --filter './apps/*' --if-present typecheck",
    "changeset": "changeset",
    "changeset-add": "bun run scripts/changeset-add.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@opentui/core": "catalog:",
    "@opentui/solid": "catalog:",
    "@types/bun": "1.4.3",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-v8": "5.0.5",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-sonarjs": "^4.2.2",
    "knip": "6.41.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "tsdown": "^0.23.1",
    "typescript": "catalog:",
    "ultracite": "8.0.1",
    "vite-plugin-solid": "2.11.14",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@chevrotain/cst-dts-gen>lodash": "4.18.1",
    "@chevrotain/cst-dts-gen>lodash-es": "4.18.1",
    "@chevrotain/gast>lodash": "4.18.1",
    "@chevrotain/gast>lodash-es": "4.18.1",
    "@effect/opentelemetry": "4.0.6",
    "@effect/platform-bun": "4.0.6",
    "@effect/platform-node": "4.0.6",
    "@effect/platform-node-shared": "4.0.6",
    "@effect/sql-d1": "4.0.6",
    "@effect/sql-sqlite-do": "4.0.6",
    "@effect/vitest": "4.0.6",
    "@opentelemetry/exporter-trace-otlp-http>@opentelemetry/core": "2.8.0",
    "@opentelemetry/otlp-exporter-base>@opentelemetry/core": "2.8.0",
    "@opentelemetry/otlp-transformer>@opentelemetry/core": "2.8.0",
    "@opentelemetry/resources>@opentelemetry/core": "2.8.0",
    "@opentelemetry/sdk-logs>@opentelemetry/core": "2.8.0",
    "@opentelemetry/sdk-metrics>@opentelemetry/core": "2.8.0",
    "@opentelemetry/sdk-trace-base>@opentelemetry/core": "2.8.0",
    "@opentelemetry/sdk-trace-node>@opentelemetry/core": "2.8.0",
    "@opentui/solid>@babel/core": "7.29.7",
    "@prisma/dev>@hono/node-server": "1.19.15",
    "@prisma/dev>hono": "4.13.8",
    "@prisma/dev>valibot": "1.4.2",
    "@scalar/json-magic>undici": "7.29.1",
    "@vercel/routing-utils>path-to-regexp": "6.3.0",
    "chevrotain>lodash": "4.18.1",
    "chevrotain>lodash-es": "4.18.1"
  },
  "packageManager": "bun@1.4.2",
  "catalog": {
    "@types/node": "26.6.5",
    "@effect/platform-bun": "4.0.6",
    "@effect/platform-node": "4.0.6",
    "@opencode/plugin": "2.1.4",
    "@opentui/core": "0.6.6",
    "@opentui/solid": "0.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "effect": "4.0.6",
    "solid-js": "1.9.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "alchemy": "2.0.0-beta.84",
    "blume": "2.2.3",
    "react-grab": "^0.2.0",
    "@alchemy.run/cloudflare": "2.0.0-beta.84"
  }
}
