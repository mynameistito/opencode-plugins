{
  "$schema": "https://www.schemastore.org/tsconfig.json",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "bun"],
    "paths": {
      "@/github/*": ["./.github/scripts/*"],
      "@/package-tarball/*": ["./scripts/package-tarball/*"],
      "@/scripts/*": ["./scripts/*"]
    },
    "strictNullChecks": true
  },
  "include": ["scripts/**/*.ts", ".github/scripts/**/*.ts"]
}
