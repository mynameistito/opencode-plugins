{
  "name": "@mynameistito/opencode-usage-limits",
  "version": "1.0.3",
  "description": "OpenCode TUI plugin that shows Codex, OpenCode GO, ZAI, Synthetic, MiniMax Token Plan, and Qwen usage limits in the sidebar and prompt footer.",
  "keywords": [
    "codex",
    "minimax",
    "minimax-token-plan",
    "opencode",
    "opencode-plugin",
    "synthetic",
    "tui",
    "usage-limits",
    "zai"
  ],
  "homepage": "https://github.com/mynameistito/opencode-plugins#readme",
  "bugs": {
    "url": "https://github.com/mynameistito/opencode-plugins/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mynameistito/opencode-plugins.git"
  },
  "files": [
    "dist",
    "examples",
    "usage-limits.schema.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    "./tui": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./schema": "./usage-limits.schema.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check": "ultracite check",
    "knip": "bunx knip@latest",
    "prepack": "bun run build",
    "test": "bun test",
    "test:package": "bun run build && bun ./scripts/test-package.ts",
    "typecheck": "tsc --noEmit",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@opencode-ai/plugin": "0.0.0-beta-18027",
    "effect": "4.0.0-beta.83"
  },
  "devDependencies": {
    "@opentui/core": "0.5.7",
    "@opentui/solid": "0.5.7",
    "solid-js": "1.9.12"
  },
  "peerDependencies": {
    "@opentui/core": "0.5.7",
    "@opentui/solid": "0.5.7",
    "solid-js": "1.9.12"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "js-yaml": "5.2.3",
    "read-yaml-file": "3.0.0",
    "seroval": "1.6.2"
  },
  "knip": {
    "ignoreDependencies": [
      "eslint-plugin-github",
      "eslint-plugin-sonarjs"
    ]
  }
}
