{
  "$schema": "https://www.schemastore.org/tsconfig.json",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/solid",
    "lib": ["ESNext", "DOM"],
    "paths": {
      "@/*": ["./src/*"],
      "@/github/*": ["../../.github/scripts/*"],
      "@/package-tarball/*": ["../../scripts/package-tarball/*"],
      "@/scripts/*": ["../../scripts/*"]
    },
    "types": ["node", "bun"],
    "strictNullChecks": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx",
    "scripts/**/*.ts"
  ]
}
