{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@mynameistito/opencode-force-input",
  "version": "1.1.6",
  "description": "OpenCode TUI plugin that interrupts the active run and submits the prompt with Ctrl+Enter.",
  "keywords": [
    "ai",
    "ai-coding",
    "ctrl-enter",
    "ctrl-return",
    "developer-tools",
    "force-input",
    "force-submit",
    "hotkey",
    "interrupt",
    "keybind",
    "keybinding",
    "keyboard",
    "keyboard-shortcuts",
    "opencode",
    "opencode-plugin",
    "opencode-tui",
    "prompt",
    "prompt-input",
    "shortcut",
    "terminal",
    "tui"
  ],
  "homepage": "https://github.com/mynameistito/opencode-plugins/tree/main/packages/opencode-force-input#readme",
  "bugs": {
    "url": "https://github.com/mynameistito/opencode-plugins/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Tito",
    "email": "github@mynameistito.com",
    "url": "https://github.com/mynameistito"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mynameistito/opencode-plugins.git",
    "directory": "packages/opencode-force-input"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "exports": {
    "./tui": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "knip": "knip",
    "prepack": "bun run build",
    "test": "bun ../../node_modules/vitest/vitest.mjs run --coverage && bun ../../scripts/check-coverage.ts coverage/lcov.info 1",
    "test:package": "bun run build && bun ./scripts/test-package.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode/plugin": "catalog:"
  },
  "devDependencies": {
    "@opentui/core": "catalog:",
    "@opentui/solid": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@opentui/core": "catalog:",
    "@opentui/solid": "catalog:",
    "solid-js": "catalog:"
  },
  "packageManager": "bun@1.4.2"
}
