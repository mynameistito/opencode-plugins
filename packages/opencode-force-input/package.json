{
  "name": "@mynameistito/opencode-force-input",
  "version": "1.0.1",
  "description": "OpenCode TUI plugin that interrupts the active run and submits the prompt with Ctrl+Enter.",
  "keywords": [
    "ctrl-enter",
    "force-submit",
    "opencode",
    "opencode-plugin",
    "tui"
  ],
  "homepage": "https://github.com/mynameistito/opencode-plugins#readme",
  "bugs": {
    "url": "https://github.com/mynameistito/opencode-plugins/issues"
  },
  "license": "MIT",
  "author": "mynameistito",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mynameistito/opencode-plugins.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "exports": {
    "./tui": {
      "types": "./dist/tui.d.mts",
      "import": "./dist/tui.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check": "ultracite check",
    "knip": "bunx knip@latest",
    "fix": "ultracite fix",
    "typecheck": "tsc --noEmit",
    "prepack": "bun run build",
    "test": "bun test",
    "test:package": "bun run build && bun ./scripts/test-package.ts"
  },
  "dependencies": {
    "@opencode-ai/plugin": "0.0.0-beta-18050",
    "@types/node": "^26.1.1"
  },
  "devDependencies": {
    "@opencode-ai/cli": "0.0.0-beta-18050",
    "@opentui/core": "0.5.7",
    "@opentui/solid": "0.5.7"
  },
  "knip": {
    "ignoreDependencies": [
      "@opencode-ai/cli"
    ]
  }
}
